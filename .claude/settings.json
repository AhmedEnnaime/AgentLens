{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(./**)",
      "Edit(./**)",
      "Write(./**)",
      "Glob",
      "Grep",
      "Bash(go build:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(go run:*)",
      "Bash(gofmt:*)",
      "Bash(gofumpt:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git push:*)",
      "Bash(gh issue:*)",
      "Bash(gh project:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(scripts/sync-agents.sh)",
      "Bash(bash scripts/sync-agents.sh)",
      "Bash(./scripts/sync-agents.sh)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Bash(git push*:--force*)",
      "Bash(git push*:-f*)",
      "Bash(git commit*:--amend*)",
      "Bash(git rebase*:-i*)",
      "Bash(git rebase*:--interactive*)",
      "Bash(git reset*:--hard*)",
      "Bash(git filter-branch*)",
      "Bash(git filter-repo*)",
      "Bash(rm *:-rf*)",
      "Bash(rm *:-fr*)",
      "Bash(sudo *)",
      "Bash(*:*| *bash*)",
      "Bash(*:*| *sh)",
      "Bash(*:*| */bin/bash*)",
      "Bash(*:*| */bin/sh*)",
      "Bash(gh pr merge*)",
      "Bash(gh repo delete*)"
    ]
  }
}